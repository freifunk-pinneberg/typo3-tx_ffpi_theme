plugin.tx_ffpinodecounter {
  settings.nodeListFile = https://2.meshviewer.pinneberg.freifunk.net/data/nodes.json
  settings.nodeListExternal = TRUE
}

lib.nodecounter = COA
lib.nodecounter {
  15 = USER
    15 {
      userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
      extensionName = FfpiNodecounter
      pluginName = CachedCounter
    }
}
